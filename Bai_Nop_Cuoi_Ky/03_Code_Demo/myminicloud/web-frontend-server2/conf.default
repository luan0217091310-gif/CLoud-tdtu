server {
  listen 80;
  server_name _;
  absolute_redirect off;
  root /usr/share/nginx/html;
  index index.html;

  add_header X-Load-Balancer-Node "web-frontend-server2" always;

  location / {
    try_files $uri $uri/ =404;
  }

  location = /blog {
    return 308 /blog/;
  }

  location ^~ /blog/ {
    alias /usr/share/nginx/html/blog/;
    index index.html;
    autoindex off;
  }

  # Health probe dùng cho job 'web' của đề bài.
  location = /metrics {
    default_type text/plain;
    return 200 "# HELP nginx_up HTTP health probe for the frontend\n# TYPE nginx_up gauge\nnginx_up 1\n";
  }

  # Exporter lấy bộ đếm thật từ Nginx trên mạng Docker nội bộ.
  location = /nginx_status {
    stub_status;
    access_log off;
    allow 127.0.0.1;
    allow 10.10.10.0/24;
    deny all;
  }
}
